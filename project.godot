config_version=5

[application]
config/name="RigPop"
config/version="0.1.0"
run/main_scene="res://editor/main.tscn"
run/main_scene.desktop_host="res://runtime/desktop/pet.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=640
window/per_pixel_transparency/allowed=true

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.94, 0.95, 0.96, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[debug]
gdscript/warnings/inference_on_variant=0
